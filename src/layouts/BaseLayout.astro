---
import "@fontsource/atkinson-hyperlegible/latin-400.css";
import "@fontsource/atkinson-hyperlegible/latin-700.css";
import "../styles/global.css";
import SkipLink from "../components/SkipLink.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description = "An environmental proposal to rethink the appearance of redaction. Protect the information. Test a lighter mark.", noindex = false } = Astro.props;
const pageTitle = title + " — Rethink Redaction";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/brand/opengraph.jpg", Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f5f4ed" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:site_name" content="Rethink Redaction" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Rethink Redaction: outlined, full-page, and lightly filled redaction examples." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>
  <SkipLink />
  <Header currentPath={Astro.url.pathname} />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
</body>
</html>
