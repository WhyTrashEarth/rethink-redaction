---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Contact Rethink Redaction.">
  <section class="section">
    <h1 class="h1">Contact</h1>
    <p class="lede">
      For press, agencies, or collaborators: use the placeholder contact details below.
     
      (We’ll wire a real inbox + policy language in Phase 1.)
    </p>

    <div class="card" style="padding:1.5rem; margin-top: 1.25rem;">
      <h2 class="h2">Email</h2>
      <p class="small">
        <strong>rethinkredaction@amantmail.com</strong> 
      </p>

      <hr />

      <h2 class="h2">Notes</h2>
      <ul>
        <li>We do not request protected personal data.</li>
        <li>If you share documents, remove sensitive fields first.</li>
      </ul>
    </div>
  </section>
</BaseLayout>