---
const { currentPath = "/" } = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact" },
];

function isActive(href) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header style="border-bottom: 1px solid var(--line); background: rgba(0,0,0,.25); backdrop-filter: blur(10px);">
  <div class="container" style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 0;">
    <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:.75rem;">
      <span aria-hidden="true" style="width:28px; height:28px; border-radius:10px; background:#111; border:1px solid var(--line); display:inline-grid; place-items:center;">▮</span>
      <span style="font-weight:800; letter-spacing:.02em;">Rethink Redaction</span>
    </a>

    <nav aria-label="Primary">
      <ul style="list-style:none; display:flex; gap:.9rem; margin:0; padding:0; flex-wrap:wrap; justify-content:flex-end;">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              style={`text-decoration:none; padding:.5rem .75rem; border-radius:999px; border:1px solid ${isActive(item.href) ? "rgba(255,255,255,.18)" : "transparent"}; background:${isActive(item.href) ? "rgba(255,255,255,.06)" : "transparent"};`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>