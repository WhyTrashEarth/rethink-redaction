---
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const nav = [
  { href: "/", label: "The comparison" },
  { href: "/about/", label: "The proposal" },
  { href: "/faq/", label: "Questions" },
  { href: "/contact/", label: "Contact" },
];
---
<header class="site-header shell">
  <a class="wordmark" href="/" aria-label="Rethink Redaction — home">
    <img src="/brand/rethink-redaction.png" width="605" height="91" alt="Rethink Redaction. A formatting efficiency recommendation." fetchpriority="high" />
  </a>
  <nav aria-label="Primary"><ul>{nav.map(({ href, label }) => <li><a href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a></li>)}</ul></nav>
</header>
